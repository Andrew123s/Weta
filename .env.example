# Copy to .env and edit. Never commit .env.
# All settings are read by apps/api/weta_api/config.py (prefix WETA_).

WETA_ENVIRONMENT=development
WETA_LOG_LEVEL=INFO

# PostgreSQL 16 + PostGIS 3.4, installed natively (see docs/deployment.md).
# Leave empty until the database exists; /api/v1/health/ready then reports "not_configured".
WETA_DATABASE_URL=postgresql+asyncpg://weta_app:CHANGE_ME@localhost:5432/weta_dev
WETA_MIGRATION_DATABASE_URL=postgresql+asyncpg://weta_migrate:CHANGE_ME@localhost:5432/weta_dev

# Used from Phase 2 (token signing). Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
WETA_SECRET_KEY=

WETA_ALLOWED_ORIGINS=["http://localhost:5173"]
WETA_FILE_STORE_ROOT=./var/filestore
WETA_MAX_UPLOAD_MB=200
